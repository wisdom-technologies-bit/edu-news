# ─────────────────────────────────────────────────────────────
# edu-news — environment configuration
# Copy to .env and adjust. Every value below has a safe default.
# ─────────────────────────────────────────────────────────────

# HTTP server
PORT=8080
HOST=0.0.0.0
NODE_ENV=production
# Comma-separated origins allowed to call the API from a browser.
# Use * to allow any origin (public read-only API).
CORS_ORIGINS=*

# ── Redis ────────────────────────────────────────────────────
# Either a single URL…
REDIS_URL=redis://127.0.0.1:6379/0
# …or discrete settings (used when REDIS_URL is empty).
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
# All keys are namespaced under this prefix.
REDIS_PREFIX=edunews

# ── Collection window ────────────────────────────────────────
# How far back each ingestion run looks for new articles.
INGEST_LOOKBACK_DAYS=10
# How long articles stay in Redis (must be >= INGEST_LOOKBACK_DAYS).
RETENTION_DAYS=21
# Max articles retained in the "recent" index.
MAX_INDEX_SIZE=8000

# ── Scheduling ───────────────────────────────────────────────
# Run an ingestion pass every N minutes (0 disables the internal scheduler).
INGEST_INTERVAL_MINUTES=30
# Run one pass immediately on boot.
INGEST_ON_BOOT=true

# ── Fetching ─────────────────────────────────────────────────
# Concurrent requests per ingestion pass.
FETCH_CONCURRENCY=8
REQUEST_TIMEOUT_MS=15000
# Polite delay between requests to the same host, milliseconds.
PER_HOST_DELAY_MS=750
# Retry attempts for transient failures (5xx, timeouts, socket errors).
FETCH_RETRIES=2
USER_AGENT=Mozilla/5.0 (compatible; EduNewsBot/1.0; +https://github.com/wisdom-technologies-bit/edu-news)
# Contact address sent in the User-Agent / From header (good crawler manners).
CONTACT_EMAIL=

# ── Extraction ───────────────────────────────────────────────
# Feed content shorter than this many characters triggers a full page fetch.
MIN_FEED_CONTENT_CHARS=1200
# Articles with less text than this are marked is_verified=false.
MIN_CONTENT_CHARS_FOR_VERIFY=400
# Cap stored Markdown size per article.
MAX_CONTENT_CHARS=60000

# ── API behaviour ────────────────────────────────────────────
# Default number of days returned by /api/news.
API_DEFAULT_DAYS=10
# Default / maximum page size.
API_DEFAULT_LIMIT=20
API_MAX_LIMIT=100
# Seconds to cache an assembled /api/news response in Redis.
RESPONSE_CACHE_SECONDS=60

# ── Security ─────────────────────────────────────────────────
# Shared secret required by POST /api/ingest.
# Leave empty to disable the endpoint entirely.
INGEST_TOKEN=
# Rate limit: requests per minute per IP for /api/*.
RATE_LIMIT_PER_MINUTE=120

# ── Optional browser renderer ────────────────────────────────
# Guardian Nigeria and TheCable sit behind a Cloudflare JS challenge that
# blocks plain HTTP clients. Enabling this renders those pages in headless
# Chromium instead. Requires `npm i playwright && npx playwright install chromium`.
ENABLE_BROWSER_RENDERER=false

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
LOG_PRETTY=false
